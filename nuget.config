<?xml version="1.0" encoding="utf-8"?>
<!-- FreeEDR keeps its NuGet packages inside the dev folder (obj\nuget\packages), never in %USERPROFILE%\.nuget. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="obj\nuget\packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
