<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Edr.Setup</RootNamespace>
    <AssemblyName>FreeEDR-Installer</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaXaml Include="..\Edr.Tray\Theme.axaml" Link="Theme.axaml" />
    <Compile Include="..\Edr.Tray\ShieldIcon.cs" Link="ShieldIcon.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Edr.Core\Edr.Core.csproj" />
  </ItemGroup>
</Project>
