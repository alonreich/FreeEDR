<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- FreeEDR theme: deep blue (not black), soft elevation, clear rounded buttons. Colors are resources so code can reuse them. -->
  <Styles.Resources>
    <!-- Colors per theme (Settings > Appearance: dark, light or the Windows setting). Styles use DynamicResource, so a
         change applies at once; code-built views take the same values from Palette (Views\Ui.cs). -->
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="BgColor">#172238</Color>
          <Color x:Key="SidebarColor">#121B2E</Color>
          <Color x:Key="SurfaceColor">#1E2C47</Color>
          <Color x:Key="SurfaceHiColor">#263859</Color>
          <Color x:Key="SurfaceLoColor">#1A2740</Color>
          <Color x:Key="LineColor">#2D3F66</Color>
          <Color x:Key="TextColor">#EAF0FB</Color>
          <Color x:Key="Text2Color">#AEBBD3</Color>
          <Color x:Key="MutedColor">#95A3BD</Color>
          <Color x:Key="AccentColor">#4F8EFF</Color>
          <Color x:Key="AccentHiColor">#6CA2FF</Color>
          <Color x:Key="AccentLoColor">#3C76E6</Color>
          <Color x:Key="OkColor">#2FBF71</Color>
          <Color x:Key="WarnColor">#F5A524</Color>
          <Color x:Key="DangerColor">#F0505F</Color>
          <Color x:Key="PausedColor">#8C99B1</Color>
          <Color x:Key="InfoColor">#3AB8E8</Color>
          <Color x:Key="SystemAccentColor">#4F8EFF</Color>
          <Color x:Key="SystemAccentColorLight1">#6CA2FF</Color>
          <Color x:Key="SystemAccentColorLight2">#8AB6FF</Color>
          <Color x:Key="SystemAccentColorDark1">#3C76E6</Color>
          <SolidColorBrush x:Key="BgBrush" Color="#172238" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#121B2E" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2C47" />
          <SolidColorBrush x:Key="SurfaceHiBrush" Color="#263859" />
          <SolidColorBrush x:Key="SurfaceLoBrush" Color="#1A2740" />
          <SolidColorBrush x:Key="LineBrush" Color="#2D3F66" />
          <SolidColorBrush x:Key="TextBrush" Color="#EAF0FB" />
          <SolidColorBrush x:Key="Text2Brush" Color="#AEBBD3" />
          <SolidColorBrush x:Key="MutedBrush" Color="#95A3BD" />
          <SolidColorBrush x:Key="AccentBrush" Color="#4F8EFF" />
          <SolidColorBrush x:Key="OkBrush" Color="#2FBF71" />
          <SolidColorBrush x:Key="WarnBrush" Color="#F5A524" />
          <SolidColorBrush x:Key="DangerBrush" Color="#F0505F" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF8A95" />
          <SolidColorBrush x:Key="PausedBrush" Color="#8C99B1" />
          <SolidColorBrush x:Key="BtnHoverBg" Color="#304370" />
          <SolidColorBrush x:Key="BtnHoverLine" Color="#46598A" />
          <SolidColorBrush x:Key="BtnDisabledBg" Color="#1C2943" />
          <SolidColorBrush x:Key="BtnDisabledFg" Color="#5F6E8C" />
          <SolidColorBrush x:Key="BtnDisabledLine" Color="#26365A" />
          <SolidColorBrush x:Key="PrimaryBg" Color="#3565C4" />
          <SolidColorBrush x:Key="PrimaryLine" Color="#3F72D6" />
          <SolidColorBrush x:Key="PrimaryFg" Color="#F2F6FF" />
          <SolidColorBrush x:Key="PrimaryHoverBg" Color="#3D70D4" />
          <SolidColorBrush x:Key="PrimaryHoverLine" Color="#4C80E4" />
          <SolidColorBrush x:Key="OkBtnBg" Color="#1D3A35" />
          <SolidColorBrush x:Key="OkBtnLine" Color="#2E5C4E" />
          <SolidColorBrush x:Key="OkBtnFg" Color="#7FD6AA" />
          <SolidColorBrush x:Key="OkBtnHoverBg" Color="#22463F" />
          <SolidColorBrush x:Key="OkBtnHoverLine" Color="#3A7262" />
          <SolidColorBrush x:Key="OkBtnHoverFg" Color="#9BE3BE" />
          <SolidColorBrush x:Key="DangerBtnBg" Color="#3A2333" />
          <SolidColorBrush x:Key="DangerBtnLine" Color="#64354A" />
          <SolidColorBrush x:Key="DangerBtnFg" Color="#F09AA4" />
          <SolidColorBrush x:Key="DangerBtnHoverBg" Color="#47293D" />
          <SolidColorBrush x:Key="DangerBtnHoverLine" Color="#7D4259" />
          <SolidColorBrush x:Key="DangerBtnHoverFg" Color="#F7B3BB" />
          <SolidColorBrush x:Key="GhostHoverBg" Color="#22324F" />
          <SolidColorBrush x:Key="LinkHoverFg" Color="#8AB6FF" />
          <SolidColorBrush x:Key="NavHoverBg" Color="#1C2A45" />
          <SolidColorBrush x:Key="NavActiveBg" Color="#22355A" />
          <SolidColorBrush x:Key="NavActiveFg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="NavActiveHoverBg" Color="#273D66" />
          <SolidColorBrush x:Key="ChipOnBg" Color="#2A4677" />
          <SolidColorBrush x:Key="ChipOnLine" Color="#5A8EF0" />
          <SolidColorBrush x:Key="ChipOnFg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="RowSelBg" Color="#23395F" />
          <SolidColorBrush x:Key="FocusRing" Color="#6CA2FF" />
          <SolidColorBrush x:Key="DangerZoneBg" Color="#2A1C29" />
          <SolidColorBrush x:Key="DangerZoneLine" Color="#7D4259" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#16223A" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1A2843" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#16223A" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#33466F" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#4A608F" />
          <!-- Settings "Advanced" parts: a calm card inside the card, not the default near-black -->
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#1A2740" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#263859" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#263859" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#2D3F66" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#2D3F66" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#2D3F66" />
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="#1A2740" />
          <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#2D3F66" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#4F8EFF" />
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#4F8EFF" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#6CA2FF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#1E2C47" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2D3F66" />
          <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#5A97FF" /><GradientStop Offset="1" Color="#3D74E4" /></LinearGradientBrush>
          <LinearGradientBrush x:Key="AccentGradientHi" StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#74A9FF" /><GradientStop Offset="1" Color="#4F86F2" /></LinearGradientBrush>
          <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#22355A" /><GradientStop Offset="1" Color="#1B2A47" /></LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="BgColor">#EEF2F8</Color>
          <Color x:Key="SidebarColor">#E3E9F3</Color>
          <Color x:Key="SurfaceColor">#FFFFFF</Color>
          <Color x:Key="SurfaceHiColor">#F0F4FA</Color>
          <Color x:Key="SurfaceLoColor">#F6F8FC</Color>
          <Color x:Key="LineColor">#D0D9E8</Color>
          <Color x:Key="TextColor">#142033</Color>
          <Color x:Key="Text2Color">#384867</Color>
          <Color x:Key="MutedColor">#56647E</Color>
          <Color x:Key="AccentColor">#2563D9</Color>
          <Color x:Key="AccentHiColor">#3B78EA</Color>
          <Color x:Key="AccentLoColor">#1D50B5</Color>
          <Color x:Key="OkColor">#1B8048</Color>
          <Color x:Key="WarnColor">#9A5B00</Color>
          <Color x:Key="DangerColor">#C42F3D</Color>
          <Color x:Key="PausedColor">#66728A</Color>
          <Color x:Key="InfoColor">#1874A3</Color>
          <Color x:Key="SystemAccentColor">#2563D9</Color>
          <Color x:Key="SystemAccentColorLight1">#3B78EA</Color>
          <Color x:Key="SystemAccentColorLight2">#5089F0</Color>
          <Color x:Key="SystemAccentColorDark1">#1D50B5</Color>
          <SolidColorBrush x:Key="BgBrush" Color="#EEF2F8" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#E3E9F3" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceHiBrush" Color="#F0F4FA" />
          <SolidColorBrush x:Key="SurfaceLoBrush" Color="#F6F8FC" />
          <SolidColorBrush x:Key="LineBrush" Color="#D0D9E8" />
          <SolidColorBrush x:Key="TextBrush" Color="#142033" />
          <SolidColorBrush x:Key="Text2Brush" Color="#384867" />
          <SolidColorBrush x:Key="MutedBrush" Color="#56647E" />
          <SolidColorBrush x:Key="AccentBrush" Color="#2563D9" />
          <SolidColorBrush x:Key="OkBrush" Color="#1B8048" />
          <SolidColorBrush x:Key="WarnBrush" Color="#9A5B00" />
          <SolidColorBrush x:Key="DangerBrush" Color="#C42F3D" />
          <SolidColorBrush x:Key="ErrorTextBrush" Color="#B42634" />
          <SolidColorBrush x:Key="PausedBrush" Color="#66728A" />
          <SolidColorBrush x:Key="BtnHoverBg" Color="#E3EAF5" />
          <SolidColorBrush x:Key="BtnHoverLine" Color="#A9B8D2" />
          <SolidColorBrush x:Key="BtnDisabledBg" Color="#F3F5F9" />
          <SolidColorBrush x:Key="BtnDisabledFg" Color="#8D98AD" />
          <SolidColorBrush x:Key="BtnDisabledLine" Color="#DDE3EE" />
          <SolidColorBrush x:Key="PrimaryBg" Color="#2563D9" />
          <SolidColorBrush x:Key="PrimaryLine" Color="#1F57C2" />
          <SolidColorBrush x:Key="PrimaryFg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryHoverBg" Color="#1F57C2" />
          <SolidColorBrush x:Key="PrimaryHoverLine" Color="#1A4CAB" />
          <SolidColorBrush x:Key="OkBtnBg" Color="#E3F4EA" />
          <SolidColorBrush x:Key="OkBtnLine" Color="#9ED2B3" />
          <SolidColorBrush x:Key="OkBtnFg" Color="#146B3A" />
          <SolidColorBrush x:Key="OkBtnHoverBg" Color="#D3EDDD" />
          <SolidColorBrush x:Key="OkBtnHoverLine" Color="#7CC29A" />
          <SolidColorBrush x:Key="OkBtnHoverFg" Color="#0F5A30" />
          <SolidColorBrush x:Key="DangerBtnBg" Color="#FBE7E9" />
          <SolidColorBrush x:Key="DangerBtnLine" Color="#E8A6AE" />
          <SolidColorBrush x:Key="DangerBtnFg" Color="#A3202E" />
          <SolidColorBrush x:Key="DangerBtnHoverBg" Color="#F7D6DA" />
          <SolidColorBrush x:Key="DangerBtnHoverLine" Color="#DD8995" />
          <SolidColorBrush x:Key="DangerBtnHoverFg" Color="#8A1826" />
          <SolidColorBrush x:Key="GhostHoverBg" Color="#E3EAF5" />
          <SolidColorBrush x:Key="LinkHoverFg" Color="#1D50B5" />
          <SolidColorBrush x:Key="NavHoverBg" Color="#D8E0EE" />
          <SolidColorBrush x:Key="NavActiveBg" Color="#CBD8F0" />
          <SolidColorBrush x:Key="NavActiveFg" Color="#0F2A5C" />
          <SolidColorBrush x:Key="NavActiveHoverBg" Color="#C0D0EE" />
          <SolidColorBrush x:Key="ChipOnBg" Color="#D6E4FB" />
          <SolidColorBrush x:Key="ChipOnLine" Color="#2563D9" />
          <SolidColorBrush x:Key="ChipOnFg" Color="#0F2A5C" />
          <SolidColorBrush x:Key="RowSelBg" Color="#DCE7FA" />
          <SolidColorBrush x:Key="FocusRing" Color="#2563D9" />
          <SolidColorBrush x:Key="DangerZoneBg" Color="#FDF1F2" />
          <SolidColorBrush x:Key="DangerZoneLine" Color="#E8A6AE" />
          <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#F7F9FD" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#B7C4DA" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#8FA3C4" />
          <!-- Settings "Advanced" parts -->
          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#F6F8FC" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#F0F4FA" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#F0F4FA" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#D0D9E8" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#D0D9E8" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#D0D9E8" />
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="#F6F8FC" />
          <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#D0D9E8" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2563D9" />
          <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2563D9" />
          <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#3B78EA" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#D0D9E8" />
          <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#3B78EA" /><GradientStop Offset="1" Color="#2459C9" /></LinearGradientBrush>
          <LinearGradientBrush x:Key="AccentGradientHi" StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#5089F0" /><GradientStop Offset="1" Color="#2F66D6" /></LinearGradientBrush>
          <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Offset="0" Color="#FFFFFF" /><GradientStop Offset="1" Color="#EEF3FB" /></LinearGradientBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <SolidColorBrush x:Key="ListBoxItemBackgroundPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="Transparent" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundPressed" Color="Transparent" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="Transparent" />
      <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter, sans-serif" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="14.5" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="12.5" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.sub"><Setter Property="Foreground" Value="{DynamicResource Text2Brush}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="11.5" /></Style>
  <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="10.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="0.6" /></Style>
  <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" /><Setter Property="FontSize" Value="11.5" /></Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #26000000" />
  </Style>
  <Style Selector="Border.hero">
    <Setter Property="Background" Value="{DynamicResource HeroGradient}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,14" />
    <Setter Property="BoxShadow" Value="0 3 12 0 #30000000" />
  </Style>
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.tile:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" /></Style>
  <!-- Keyboard focus on a clickable tile (Home): a visible ring -->
  <Style Selector="Border.tile:focus-visible"><Setter Property="BoxShadow" Value="0 0 0 2 #6CA2FF" /></Style>
  <Style Selector="Button:focus-visible, ToggleButton:focus-visible, ToggleSwitch:focus-visible, ComboBox:focus-visible, CheckBox:focus-visible, RadioButton:focus-visible, NumericUpDown:focus-within, TextBox:focus-within, TimePicker:focus-visible">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2" BorderBrush="{DynamicResource FocusRing}" CornerRadius="7" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!-- Settings: destructive actions at the bottom, in a red-edged card -->
  <Style Selector="Border.dangerzone">
    <Setter Property="Background" Value="{DynamicResource DangerZoneBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerZoneLine}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="7,1" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Buttons: one base shape, five intents -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BtnHoverBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BtnHoverLine}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button:pressed"><Setter Property="RenderTransform" Value="scale(0.97)" /></Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BtnDisabledBg}" />
    <Setter Property="Foreground" Value="{DynamicResource BtnDisabledFg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BtnDisabledLine}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryLine}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHoverLine}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryFg}" />
  </Style>
  <Style Selector="Button.ok">
    <Setter Property="Background" Value="{DynamicResource OkBtnBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OkBtnLine}" />
    <Setter Property="Foreground" Value="{DynamicResource OkBtnFg}" />
  </Style>
  <Style Selector="Button.ok:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource OkBtnHoverBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OkBtnHoverLine}" />
    <Setter Property="Foreground" Value="{DynamicResource OkBtnHoverFg}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerBtnBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBtnLine}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBtnFg}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBtnHoverBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBtnHoverLine}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBtnHoverFg}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GhostHoverBg}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LinkHoverFg}" />
  </Style>
  <Style Selector="Button.small"><Setter Property="MinHeight" Value="26" /><Setter Property="Padding" Value="10,3" /><Setter Property="FontSize" Value="11.5" /></Style>
  <Style Selector="Button.big"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="16,6" /><Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="7" /></Style>
  <!-- Settings: the (i) explanation next to a label (click, Enter or Space opens it; it gets the focus ring above) -->
  <Style Selector="Button.info">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="3,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Help" />
  </Style>
  <Style Selector="Button.info:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource GhostHoverBg}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- Settings: the save bar pinned to the bottom of the page while there is something to save -->
  <Style Selector="Border.savebar">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,10" />
  </Style>

  <!-- Sidebar navigation -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBg}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
  </Style>
  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavActiveHoverBg}" />
    <Setter Property="Foreground" Value="{DynamicResource NavActiveFg}" />
  </Style>

  <!-- Filter chips -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BtnHoverLine}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ChipOnBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ChipOnLine}" />
    <Setter Property="Foreground" Value="{DynamicResource ChipOnFg}" />
  </Style>

  <!-- Lists -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.1" /><BrushTransition Property="BorderBrush" Duration="0:0:0.1" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem:pointerover Border.row"><Setter Property="Background" Value="{DynamicResource SurfaceHiBrush}" /></Style>
  <Style Selector="ListBoxItem:selected Border.row">
    <Setter Property="Background" Value="{DynamicResource RowSelBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!-- Reviewed rows: a darker card instead of transparency, so their text keeps at least 4.5:1 contrast -->
  <Style Selector="Border.row.muted"><Setter Property="Background" Value="{DynamicResource SurfaceLoBrush}" /></Style>
  <Style Selector="ListBoxItem:pointerover Border.row.muted"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Style>
  <Style Selector="ListBoxItem:selected Border.row.muted"><Setter Property="Background" Value="{DynamicResource RowSelBg}" /></Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True" />
  </Style>
</Styles>
