<Project Sdk="Microsoft.NET.Sdk">
  <!-- FreeEDR tray icon + dashboard. Unelevated; reads C:\Program Files\FreeEDR, sends commands through EDR-Control.ps1 (UAC) or inbox\. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Edr.Tray</RootNamespace>
    <AssemblyName>FreeEDR-Tray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Edr.Core\Edr.Core.csproj" />
  </ItemGroup>
</Project>
